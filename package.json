{
  "name": "pacebox",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "overrides": {
    "@expo/cli": "57.0.8",
    "@expo/metro-config": "57.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "notify:server": "node scripts/notify-server.mjs",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.6",
    "expo-asset": "57.0.21",
    "expo-audio": "57.0.5",
    "expo-constants": "57.0.5",
    "expo-file-system": "57.0.7",
    "expo-linking": "57.0.3",
    "expo-notifications": "57.0.5",
    "expo-router": "57.0.6",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "57.1.1",
    "expo-splash-screen": "57.0.4",
    "expo-status-bar": "57.0.1",
    "lucide-react-native": "1.24.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "babel-preset-expo": "57.0.3",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.0",
    "typescript": "6.0.3",
    "vitest": "3.2.7"
  }
